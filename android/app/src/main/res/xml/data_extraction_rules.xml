<?xml version="1.0" encoding="utf-8"?>
<!-- App settings, favourites and songs share FlutterSharedPreferences.xml.
     Drift uses Flutter's documents directory (app_flutter), not databases/.
     Include SQLite recovery files; -shm is transient and is rebuilt by SQLite.
     An include list excludes every other file, including future SDK data. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <include domain="root" path="app_flutter/frequenza.sqlite" />
        <include domain="root" path="app_flutter/frequenza.sqlite-wal" />
        <include domain="root" path="app_flutter/frequenza.sqlite-journal" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <include domain="root" path="app_flutter/frequenza.sqlite" />
        <include domain="root" path="app_flutter/frequenza.sqlite-wal" />
        <include domain="root" path="app_flutter/frequenza.sqlite-journal" />
    </device-transfer>
</data-extraction-rules>
